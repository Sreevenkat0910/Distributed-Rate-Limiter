APP_ENV=local
LOG_LEVEL=INFO

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_CALL_TIMEOUT_MS=75

BREAKER_FAIL_MAX=5
BREAKER_RESET_TIMEOUT_SECONDS=30

HOST=0.0.0.0
PORT=8000

# Benchmarking-only kill switch -- set false to run without the rate
# limiter middleware at all (see /loadtest).
RATE_LIMITER_ENABLED=true
